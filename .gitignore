# ---- Secrets & credentials (NEVER commit) ----
*.pem
*.key
.env
.env.*
**/credentials
aws-credentials*
# Local values may contain account IDs / sensitive values; keep only templates.
*.tfvars
!*.tfvars.example

# pokemon-monitor live config holds a real Discord webhook — keep only the template
config.yaml
**/config.yaml
!config.example.yaml
!**/config.example.yaml
# runtime state files (regenerable)
monitor_state.json
**/monitor_state.json
**/*_state.json
# Playwright browser profile — huge, and contains live session cookies/PII
browser_data/
**/browser_data/

# ---- Terraform ----
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# NOTE: .terraform.lock.hcl is intentionally committed to pin provider versions
# for reproducible CI. (gitignore does not support end-of-line comments, so this
# explanation lives on its own line.)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan
backend.hcl
infra/modules/app/build/

# ---- Python ----
.venv/
.venv-verify/
artifacts/
**/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- ML artifacts (large / regenerable) ----
detection/models/*.h5
detection/models/*.pkl
detection/models/*.joblib
detection/data/*.csv
detection/data/*.parquet

# ---- Logs & local tool config ----
*.log
.claude/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
